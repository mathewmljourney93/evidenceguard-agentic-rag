# Normalize text to LF in the repository and working tree by default.
* text=auto eol=lf

# Source, docs and configuration: always LF.
*.py    text eol=lf
*.pyi   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.json  text eol=lf
*.ini   text eol=lf
*.cfg   text eol=lf
*.sql   text eol=lf
*.sh    text eol=lf
Dockerfile text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf
.env.example   text eol=lf

# Windows-only scripts: keep CRLF so cmd.exe and PowerShell 5.1 handle them reliably.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary formats: never normalize or diff as text.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
