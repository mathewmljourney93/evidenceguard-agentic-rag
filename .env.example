# Placeholders only. Copy the variable names into your shell environment and fill in your own
# values. EvidenceGuard does not read a .env file automatically, and real values must never
# be committed.

# Application database (used by online migrations).
EG_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5433/DATABASE

# Disposable test database for integration tests. Its name must end in "_test"; the tests
# drop and recreate its schema.
EG_TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5433/DATABASE_test
